# --- Auth (Sprint 9E + 9F) ---------------------------------------------------
# When true, /admin/login and /dealer/login render BOTH the real password form
# AND the dev mock pickers, and the matching mock login routes accept
# submissions. When false (production), only the real password form is shown
# and mock POSTs are rejected with HTTP 503. Production deploys MUST leave
# this unset or set to false.
DEV_AUTH_MODE=true

# HMAC secret used to sign all three session cookies (customer / admin /
# dealer). In dev a fixed fallback is used (with a console.warn). Production
# MUST set a long random value (e.g. `openssl rand -base64 48`).
AUTH_SESSION_SECRET=

# SHA-256 salt used when hashing customer phone numbers before storage /
# logging. In dev a fixed fallback is used. Production MUST set this — the
# server will refuse to start without it.
OTP_PHONE_HASH_SALT=

# --- Database (Sprint 9B) ----------------------------------------------------
# Postgres connection string. Leave empty (or unset) to run in fallback mode:
# the app uses the in-memory globalThis stores and AuditLog is non-persistent.
# Set to a real URL to switch on DB mode + AuditLog persistence.
# Example: postgresql://user:pass@localhost:5432/zolaq?schema=public
DATABASE_URL=

# Optional. Direct (non-pooled) URL for `prisma migrate`. Only needed when
# DATABASE_URL points at PgBouncer / Supabase pooler.
DIRECT_URL=

# --- Media upload (Sprint 9D) ------------------------------------------------
# Storage backend. Only "local" is implemented this sprint — files land under
# /public/uploads/. Future providers (s3 / r2 / supabase) documented in
# docs/sprint-9d/STORAGE_PROVIDER_DECISION.md.
MEDIA_STORAGE_PROVIDER=local

# Max upload size in megabytes. Validated server-side in lib/media/validation.ts.
MEDIA_UPLOAD_MAX_MB=8

# Public URL prefix where uploaded files are served. For local provider this
# matches /public/uploads served by Next.js at /uploads/...
MEDIA_PUBLIC_BASE_URL=/uploads

# --- VIN Check (Sprint 9H) ---------------------------------------------------
# SHA-256 salt used when hashing VIN values for VinCheckRequest / VinCheckCache.
# Raw VIN is never persisted; only the hash. In dev a fixed fallback is used.
# Production MUST set this — the server will throw before computing a hash
# without it. Rotation invalidates all existing hashes; treat as permanent.
VIN_HASH_SALT=

# --- SMS provider (Sprint 9F) ------------------------------------------------
# Provider selector for outbound OTP delivery.
#   mock     — log [MOCK-OTP] to the server console. Dev only; refused in
#              production (NODE_ENV=production) unless DEV_AUTH_MODE=true.
#   http     — POST to SMS_API_URL with bearer auth. Required: SMS_API_URL,
#              SMS_API_KEY, SMS_SENDER_ID.
#   disabled — refuse to send; the OTP route returns AUTH_NOT_AVAILABLE.
# Default: mock in development, disabled in production.
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_MS=5000

# --- Staging protection (Sprint 10B) -----------------------------------------
# When "true", proxy.ts emits X-Robots-Tag: noindex, nofollow, noarchive on
# every response, and app/robots.ts emits a deny-all robots.txt. Set this on
# the Vercel STAGING environment. Leave UNSET on the Vercel Production
# environment so public launch SEO is not blocked. The proxy also auto-applies
# noindex when the request Host is `staging.zolaq.az`, regardless of this env.
# See docs/sprint-10/STAGING_NOINDEX_POLICY.md.
STAGING_NO_INDEX=

# Default base URL for `node scripts/closed-beta-smoke.mjs`. Override per run.
# Example: BETA_SMOKE_BASE_URL=https://staging.zolaq.az
BETA_SMOKE_BASE_URL=

# --- Beta feature flags (Sprint 10D) -----------------------------------------
# Both flags are client-readable (NEXT_PUBLIC_ prefix). Default off — production
# stays dark. Toggle in .env.local for local demo. See
# docs/sprint-10/MASTER_ADMIN_DATA_INVENTORY.md and I18N_BETA_SCOPE.md.

# Renders a VIN risk-check beta card on the homepage between Trust and Decision
# sections. The CTA opens a format-validation modal — no provider call, no
# persistence, VIN never leaves the modal state.
NEXT_PUBLIC_FEATURE_VIN_BETA=false

# Wraps the public layout in a client-side LocaleProvider and reveals an
# AZ/RU/EN selector in the Header. Only Header nav labels and homepage Quick
# Search title/subtitle are wired this sprint; the rest of the app stays AZ.
# No /ru or /en route segments are created.
NEXT_PUBLIC_FEATURE_I18N_BETA=false

# --- Beta acquisition (Sprint 10J) -------------------------------------------
# First 100 closed-beta invite surface. All three vars are NEXT_PUBLIC_ —
# client-readable, identical on server and client. No backend, no DB, no PII.
# See docs/sprint-10/FIRST_100_BETA_PLAN.md and BETA_FEEDBACK_SYSTEM.md.

# Toggles the HomeBetaInviteCard on the homepage (rendered after the
# Decision Helper). false = no CTA shown anywhere. Default off in production.
NEXT_PUBLIC_FEATURE_BETA_INVITE=false

# External waitlist form URL — Google Form / Tally / Typeform / Airtable.
# When the flag above is true AND this URL is non-empty, the CTA opens it
# in a new tab. When this URL is empty (and the flag is on), the CTA falls
# back to a safe disabled "tezliklə aktiv olacaq" state. No backend storage.
NEXT_PUBLIC_BETA_WAITLIST_URL=

# External feedback form URL — separate intake from the waitlist. Linked from
# the welcome / nudge message templates in FIRST_100_BETA_COPY.md. Not read
# by app code in Sprint 10J; documented here so the operator has one canonical
# spot for both URLs.
NEXT_PUBLIC_BETA_FEEDBACK_URL=

# --- Market Intelligence beta (Sprint 10J) -----------------------------------
# Client-readable (NEXT_PUBLIC_ prefix). Default off — production stays dark.
# Sprint 10J ships the Market Intelligence DATA FOUNDATION only (types +
# deterministic utilities + demo data under lib/market-intelligence/). There is
# NO public UI wired to this flag yet; it must not be enabled in production.
# Toggle in .env.local only for internal/dev preview work. Market Intelligence
# explains platform interest, price movement and confidence — never investment,
# trading or prediction-market behavior. See docs/sprint-10j/.
NEXT_PUBLIC_FEATURE_MARKET_INTELLIGENCE_BETA=false

# --- Admin bootstrap (Sprint 9F) ---------------------------------------------
# One-time seed for the initial super_admin. Run `npm run bootstrap:admin`
# once after the database is migrated. The script hashes the password with
# node:crypto scrypt and upserts the AdminUser + super_admin role. Never
# commit real values. Treat INITIAL_ADMIN_PASSWORD as a write-once secret;
# rotate the admin's password via a proper change-password flow afterward.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
